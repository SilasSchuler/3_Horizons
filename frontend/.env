# Path to the "python/" folder from the hackathon starter kit (contains
# config.json, abi/, oracle_writer.py, settlement_trigger.py, logs/).
# Adjust to wherever it actually sits relative to this backend folder.
PYTHON_DIR=../python

# Port the dashboard + API run on
PORT=3000

# NOTE: this file intentionally contains no private keys. Private keys stay
# in python/.env and are never read by, or sent through, this backend.